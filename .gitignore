# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# KUCCPS source PDFs (copyrighted; parsed into data/*.json, which is committed). Keep the folder.
/data/raw/*
!/data/raw/.gitkeep

# editors & OS
.vscode/
.idea/
*.swp
Thumbs.db

# logs & test output
*.log
/playwright-report/
/test-results/
